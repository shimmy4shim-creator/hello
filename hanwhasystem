      return {
        po, line, material, part: core.clean(item.part), due: core.date(item.due), qty,
        sales: core.clean(item.sales), prod: core.clean(item.prod), quality: core.clean(item.quality),
        done: item.done === true, delivered: core.date(item.delivered)
      };
    });
    const ids = new Set(rows.map(core.key));
    if (ids.size !== rows.length) throw new Error("백업에 같은 발주번호·항번·자재코드 조합이 있습니다.");
    const stocks = raw.stocks.map(item => {
      const part = core.clean(item?.part);
      const amount = item?.amount;
      if (!part || !Number.isSafeInteger(amount) || amount < 0) {
        throw new Error("백업의 품번과 재고 수량을 확인해 주세요.");
      }
      return {part, amount};
    });
    if (new Set(stocks.map(stock => stock.part)).size !== stocks.length) {
      throw new Error("백업에 중복된 품번 재고가 있습니다.");
    }
    const history = raw.history.filter(item => Object.hasOwn(modes, item?.mode) && Number.isFinite(Date.parse(item.at)))
      .slice(0, 60).map(item => ({
        mode: item.mode, at: item.at, file: core.clean(item.file), summary: core.clean(item.summary)
      }));
    return {
      schema: 1, rev: core.clean(raw.rev), rows, stocks,
      newest: [...new Set(raw.newest.filter(id => ids.has(id)))], history
    };
  }

  function readLocal() {
    const data = localStorage.getItem(storageKey);
    return data ? validate(JSON.parse(data)) : core.fresh();
  }
  try { state = readLocal(); } catch { browserSave = false; }

  function notify(message) {
    const toast = $("toast");
    toast.textContent = message;
    toast.hidden = false;
    clearTimeout(messageTimeout);
    messageTimeout = setTimeout(() => { toast.hidden = true; }, 4500);
  }

  async function commit(next, expected = state.rev) {
    const save = () => {
      if (expected !== state.rev) {
        notify("자료가 변경됐습니다. 화면을 다시 열어 확인해 주세요.");
        return false;
      }
      if (browserSave) {
        try {
          const latest = readLocal();
          if (latest.rev !== expected) {
            state = latest;
            render();
            notify("다른 탭에서 자료가 갱신됐습니다. 변경사항을 다시 확인해 주세요.");
            return false;
          }
        } catch { browserSave = false; }
      }
      state = {...next, rev: `${Date.now()}-${Math.random().toString(36).slice(2)}`};
      if (browserSave) {
        try { localStorage.setItem(storageKey, JSON.stringify(state)); }
        catch { browserSave = false; }
      }
      render();
      return true;
    };
    let locks;
    try { if (browserSave) locks = navigator.locks; } catch {}
    return locks ? locks.request(storageKey, save) : save();
  }

  function changeTab(tab) {
    active = tab;
    render();
  }

  function matching(row, newest, search) {
    if (filter === "open" && row.done) return false;
    if (filter === "done" && !row.done) return false;
    if (filter === "new" && !newest.has(core.key(row))) return false;
    if (filter === "short" && !(row.shortage > 0)) return false;
    return !search || [row.po, row.line, row.material, row.part].some(value => value.toLowerCase().includes(search));
  }

  function renderMeeting() {
    const newest = new Set(state.newest);
    const planned = current.planned;
    const done = planned.reduce((n, row) => n + Number(row.done), 0);
    const counters = [
      ["open", "납품예정", planned.length - done], ["new", "신규 추가", newest.size],
      ["done", "납품완료", done], ["short", "재고 부족", planned.filter(row => row.shortage > 0).length]
    ];
    $("counters").innerHTML = counters.map(([id, label, value]) =>
      `<button class="metric ${id}" data-filter="${id}" aria-pressed="${filter === id}">
        <span>${label}</span><strong>${fmt(value)}</strong></button>`
    ).join("");
    const search = $("search").value.trim().toLowerCase();
    const shown = planned.filter(row => matching(row, newest, search));
    page = Math.max(0, Math.min(page, Math.ceil(shown.length / pageSize) - 1));
    $("filter").value = filter;
    $("meetingCount").textContent = `${fmt(shown.length)} / ${fmt(planned.length)}건`;
    $("meetingEmpty").hidden = planned.length > 0;
    $("meetingTable").hidden = !planned.length;
    const ids = new Map(state.rows.map((row, index) => [core.key(row), index]));
    $("orders").innerHTML = shown.slice(page * pageSize, (page + 1) * pageSize).map(row => {
      const id = core.key(row);
      return `<tr>
        <td><strong class="code">${h(row.po)}</strong><small>항번 ${h(row.line)}</small></td>
        <td><strong class="code">${h(row.material)}</strong><small>${row.part ? h(row.part) : "품번 미지정"}</small></td>
        <td>${h(row.due || "미정")}${row.delivered && row.done ? `<small>납품 ${h(row.delivered)}</small>` : ""}</td>
        <td class="numeric">${fmt(row.qty)}</td>
        <td class="numeric ${row.shortage > 0 ? "warning" : ""}">${fmt(row.after)}${row.shortage > 0 ? `<small>${fmt(row.shortage)}개 부족</small>` : ""}</td>
        <td><span class="tag ${row.done ? "done" : "open"}">${row.done ? "납품완료" : "납품예정"}</span>${newest.has(id) ? '<span class="tag new">신규 추가</span>' : ""}</td>
        ${core.notes.map(field => `<td class="noteCell"><span title="${h(row[field])}">${h(row[field] || "—")}</span></td>`).join("")}
        <td><button class="compact" data-edit="${ids.get(id)}" aria-label="${h(core.describe(row))} 확인사항 편집">편집</button></td>
      </tr>`;
    }).join("") || '<tr><td colspan="10" class="emptyCell">조건에 맞는 항목이 없습니다.</td></tr>';
    $("prev").disabled = page === 0;
    $("next").disabled = (page + 1) * pageSize >= shown.length;
    $("pages").textContent = shown.length ? `${page + 1} / ${Math.ceil(shown.length / pageSize)}` : "0 / 0";
  }

  function renderInventory() {
    const parts = [...new Set(state.rows.map(row => row.part).filter(Boolean))].sort();
    $("partOptions").innerHTML = parts.map(part => `<option value="${h(part)}"></option>`).join("");
    const rows = [...current.balances].sort(([a], [b]) => a.localeCompare(b, "ko", {numeric: true}));
    $("stockRows").innerHTML = rows.map(([part, balance]) => `<tr>
      <td><strong class="code">${h(part)}</strong></td><td class="numeric">${fmt(balance.amount)}</td>
      <td class="numeric">${fmt(balance.demand)}</td><td class="numeric ${balance.after < 0 ? "warning" : ""}">${fmt(balance.after)}</td>
      <td><button class="compact" data-stock="${h(part)}">수정</button></td>
    </tr>`).join("") || '<tr><td class="emptyCell" colspan="5">등록한 품번 재고가 없습니다.</td></tr>';
  }

  function renderHistory() {
    $("historyRows").innerHTML = state.history.map(entry => `<tr>
      <td>${h(timestamp.format(new Date(entry.at)))}</td><td>${h(modes[entry.mode])}</td>
      <td class="fileCell">${h(entry.file)}</td><td>${h(entry.summary)}</td></tr>`).join("") ||
      '<tr><td class="emptyCell" colspan="4">아직 반영한 파일이 없습니다.</td></tr>';
  }

  function render() {
    current = core.schedule(state);
    $("browserStatus").textContent = browserSave ? "이 브라우저에 저장" : "현재 창에 임시 보관";
    $("browserStatus").classList.toggle("warning", !browserSave);
    for (const tab of tabs) {
      $(tab + "Pane").hidden = active !== tab;
      $(tab + "Tab").setAttribute("aria-pressed", String(active === tab));
    }
    $("export").disabled = !state.rows.length;
    $("backup").disabled = !(state.rows.length || state.stocks.length);
    if (active === "meeting") renderMeeting();
    if (active === "inventory") renderInventory();
    if (active === "history") renderHistory();
  }

  function review() {
    const {sheet, headerNumber, mapping, mode} = operation;
    const parsed = core.parseRows(sheet, headerNumber, mapping, mode);
    if (parsed.error) {
      $("review").textContent = parsed.error;
      $("apply").disabled = true;
      return;
    }
    const change = core.reconcile(state, parsed, mode, $("refresh").checked);
    const warnings = [
      ...parsed.issues.map(issue => `${issue.n}행 · ${issue.reason}`),
      ...change.partChanges.map(row => `기존 품번 유지 · ${row}`),
      ...change.missing.map(row => `계획표에서 찾지 못함 · ${row}`)
    ];
    const counts = mode === "plan"
      ? [["추가", change.added.length], ["기존 일치", change.matched], ["납기·수량 변경 감지", change.schedule]]
      : [["새로 납품완료", change.completed], ["계획표와 일치", change.matched], ["미일치", change.missing.length]];
    const summary = counts.map(([label, n]) => `<span>${label} <strong>${fmt(n)}건</strong></span>`).join("");
    const info = [];
    if (mode === "plan" && change.baseline && change.added.length) info.push("첫 계획은 기준 자료로 등록됩니다.");
    if (mode === "plan" && (mapping.part < 0 || mapping.qty < 0)) info.push("재고 계산에 사용할 품번과 납품예정수량 열을 지정해 주세요.");
    if (parsed.repeats) info.push(`같은 키의 중복 ${fmt(parsed.repeats)}행을 한 건씩 처리합니다.`);
    if (!change.added.length && !change.changed) info.push("현재 회의자료에 반영할 변경사항이 없습니다.");
    $("review").innerHTML = `<div class="counts">${summary}</div>${info.map(line => `<p>${h(line)}</p>`).join("")}
      ${warnings.length ? `<details><summary>확인 필요 ${fmt(warnings.length)}건</summary>
        <ul>${warnings.slice(0, 25).map(warning => `<li>${h(warning)}</li>`).join("")}</ul>
        ${warnings.length > 25 ? "<p>처음 25건을 표시합니다.</p>" : ""}</details>` : ""}`;
    $("apply").disabled = !change.added.length && !change.changed;
  }

  function drawMapping() {
    const {sheet, fields, headerNumber, mapping} = operation;
    const headings = sheet.rows.find(row => row.number === headerNumber)?.cells ?? [];
    const examples = sheet.rows.filter(row => row.number > headerNumber).slice(0, 4);
    const count = Math.max(headings.length, ...examples.map(row => row.cells.length), 0);
    const columns = Array.from({length: count}, (_, i) => {
      const head = core.clean(headings[i]);
      const example = examples.map(row => core.clean(row.cells[i])).find(Boolean) ?? "";
      return `${files.column(i)}${head ? " · " + head : ""}${example ? " | " + example.slice(0, 45) : ""}`;
    });
    $("mapping").innerHTML = fields.map(field => `<label>${h(core.labels[field])}${core.keys.includes(field) ? ' <span class="required">필수</span>' : ""}
      <select data-field="${field}" aria-label="${h(core.labels[field])}">
        <option value="-1">열 선택</option>
        ${columns.map((label, i) => `<option value="${i}" ${i === mapping[field] ? "selected" : ""}>${h(label)}</option>`).join("")}
      </select></label>`).join("");
    review();
  }

  function headerChanged(number) {
    operation.headerNumber = Math.max(1, Number(number) || 1);
    const headings = operation.sheet.rows.find(row => row.number === operation.headerNumber)?.cells ?? [];
    operation.mapping = core.suggest(headings, operation.fields);
    drawMapping();
  }

  async function selectSheet(index) {
    const task = operation;
    const generation = (task.generation ?? 0) + 1;
    task.generation = generation;
    $("importBody").hidden = true;
    $("apply").disabled = true;
    $("importMessage").textContent = "시트의 열을 읽는 중입니다.";
    try {
      const sheet = await task.book.sheet(index);
      if (operation !== task || task.generation !== generation) return;
      task.sheet = sheet;
      $("headerRow").value = core.guess(sheet.rows, task.fields).best;
      $("importBody").hidden = false;
      $("importMessage").textContent = sheet.rows.length ? "" : "선택한 시트에 읽을 행이 없습니다.";
      headerChanged($("headerRow").value);
    } catch (error) {
      if (operation === task) $("importMessage").textContent = error.message || "선택한 시트를 읽지 못했습니다.";
    }
  }

  async function selectFile(file, mode) {
    const task = {file, mode, fields: mode === "plan" ? core.planFields : core.deliveryFields, expected: state.rev};
    operation = task;
    $("importTitle").textContent = modes[mode] + " 반영";
    $("filename").textContent = file.name;
    $("importBody").hidden = true;
    $("sheetSelect").disabled = true;
    $("sheetSelect").innerHTML = "";
    $("refresh").checked = false;
    $("refreshLine").hidden = mode !== "plan";
    $("materialHint").hidden = mode !== "plan";
    $("importMessage").textContent = "파일을 읽는 중입니다.";
    $("apply").disabled = true;
    $("importDialog").showModal();
    try {
      task.book = await files.open(file);
      if (operation !== task) return;
      $("sheetSelect").innerHTML = task.book.names.map((name, i) => `<option value="${i}">${h(name)}</option>`).join("");
      $("sheetSelect").disabled = false;
      await selectSheet(0);
    } catch (error) {
      if (operation === task) $("importMessage").textContent = error.message || "파일을 열지 못했습니다.";
    }
  }

  async function applyImport() {
    if (!operation?.sheet) return;
    const task = operation;
    const parsed = core.parseRows(task.sheet, task.headerNumber, task.mapping, task.mode);
    if (parsed.error) return;
    if (task.expected !== state.rev) {
      task.expected = state.rev;
      review();
      $("importMessage").textContent = "회의자료가 갱신됐습니다. 변경 건수를 다시 확인해 주세요.";
      return;
    }
    const change = core.reconcile(state, parsed, task.mode, $("refresh").checked);
    if (!change.changed && !change.added.length) return;
    $("apply").disabled = true;
    const summary = task.mode === "plan"
      ? `추가 ${change.added.length}건 · 기존 갱신 ${change.changed}건`
      : `새로 납품완료 ${change.completed}건 · 미일치 ${change.missing.length}건`;
    const newest = task.mode === "plan" ? (change.baseline ? [] : change.added) : state.newest;
    const history = [{mode: task.mode, at: new Date().toISOString(), file: task.file.name, summary}, ...state.history].slice(0, 60);
    const saved = await commit({...state, rows: [...change.rows.values()], newest, history}, task.expected);
    if (!saved) {
      task.expected = state.rev;
      review();
      $("importMessage").textContent = "회의자료가 갱신됐습니다. 변경 건수를 다시 확인해 주세요.";
      return;
    }
    $("importDialog").close();
    page = 0;
    filter = "all";
    $("search").value = "";
    changeTab("meeting");
    notify(browserSave ? summary + " 반영" : "현재 창에 반영했습니다. 반영 이력에서 백업할 수 있습니다.");
  }

  function edit(index) {
    const row = state.rows[index];
    if (!row) return;
    editing = {id: core.key(row), expected: state.rev};
    $("editMeta").textContent = core.describe(row);
    $("editPart").value = row.part;
    $("editDue").value = row.due;
    $("editQuantity").value = row.qty ?? "";
    $("noteFields").innerHTML = core.notes.map(field => `<label>${h(core.labels[field])}
      <textarea name="${field}" rows="3">${h(row[field])}</textarea></label>`).join("");
    $("editDialog").showModal();
  }

  function saveFile(blob, name) {
    const address = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = address;
    link.download = name;
    document.body.append(link);
    link.click();
    link.remove();
    setTimeout(() => URL.revokeObjectURL(address), 30000);
  }

  function exportReport() {
    const newest = new Set(state.newest);
    const headings = ["발주번호", "항번", "자재코드", "품번", "납기일", "납품예정수량", "진행상태",
      "납품일", "신규구분", "배정 후 예상 재고", "부족 수량", ...core.notes.map(field => core.labels[field])];
    const records = current.planned.map(row => [
      row.po, row.line, row.material, row.part, row.due, row.qty, row.done ? "납품완료" : "납품예정", row.delivered,
      newest.has(core.key(row)) ? "신규 추가" : "", row.after, row.shortage, ...core.notes.map(field => row[field])
    ]);
    saveFile(files.workbook([headings, ...records]), `한화시스템_회의자료_${reportDate()}.xlsx`);
  }

  for (const tab of tabs) $(tab + "Tab").onclick = () => changeTab(tab);
  for (const mode of Object.keys(modes)) {
    const input = $(mode + "File");
    $(mode + "Button").onclick = () => input.click();
    input.onchange = () => {
      const [file] = input.files;
      input.value = "";
      if (file) selectFile(file, mode);
    };
  }
  $("firstPlan").onclick = () => $("planFile").click();
  $("importDialog").onclose = () => { operation = null; };
  $("sheetSelect").onchange = event => selectSheet(Number(event.target.value));
  $("headerRow").onchange = event => headerChanged(event.target.value);
  $("mapping").onchange = event => {
    const field = event.target.dataset.field;
    if (field) {
      operation.mapping[field] = Number(event.target.value);
      review();
    }
  };
  $("refresh").onchange = review;
  $("apply").onclick = applyImport;
  $("export").onclick = exportReport;
  $("search").oninput = () => { page = 0; renderMeeting(); };
  $("filter").onchange = event => { filter = event.target.value; page = 0; renderMeeting(); };
  $("counters").onclick = event => {
    const button = event.target.closest("[data-filter]");
    if (button) {
      filter = filter === button.dataset.filter ? "all" : button.dataset.filter;
      page = 0;
      renderMeeting();
    }
  };
  $("prev").onclick = () => { page--; renderMeeting(); };
  $("next").onclick = () => { page++; renderMeeting(); };
  $("orders").onclick = event => {
    const button = event.target.closest("[data-edit]");
    if (button) edit(Number(button.dataset.edit));
  };
  $("editForm").onsubmit = async event => {
    event.preventDefault();
    if (!editing) return;
    const form = new FormData(event.currentTarget);
    const converted = core.quantity($("editQuantity").value);
    if (converted === undefined) {
      notify("수량을 0 이상의 정수로 입력해 주세요.");
      return;
    }
    const rows = state.rows.map(row => core.key(row) === editing.id
      ? {...row, part: core.clean($("editPart").value), due: $("editDue").value, qty: converted,
        ...Object.fromEntries(core.notes.map(field => [field, core.clean(form.get(field))]))}
      : row);
    if (await commit({...state, rows}, editing.expected)) {
      $("editDialog").close();
      notify("확인사항을 반영했습니다.");
    } else {
      $("editMeta").textContent = "자료가 갱신됐습니다. 창을 다시 열어 확인해 주세요.";
    }
  };
  $("stockRows").onclick = event => {
    const button = event.target.closest("[data-stock]");
    if (!button) return;
    $("stockPart").value = button.dataset.stock;
    $("stockNumber").value = current.balances.get(button.dataset.stock).amount;
    $("stockNumber").focus();
  };
  $("stockForm").onsubmit = async event => {
    event.preventDefault();
    const part = core.clean($("stockPart").value);
    const amount = core.quantity($("stockNumber").value);
    if (!part || !Number.isSafeInteger(amount)) {
      notify("품번과 0 이상의 정수 재고를 입력해 주세요.");
      return;
    }
    const stocks = state.stocks.filter(stock => stock.part !== part);
    stocks.push({part, amount});
    if (await commit({...state, stocks})) notify("품번 재고를 반영했습니다.");
  };
  $("backup").onclick = () => saveFile(new Blob([JSON.stringify(state)], {type: "application/json"}), `회의자료_백업_${reportDate()}.json`);
  $("restoreButton").onclick = () => $("restoreFile").click();
  $("restoreFile").onchange = async event => {
    const [file] = event.target.files;
    event.target.value = "";
    if (!file) return;
    try {
      const next = validate(JSON.parse(await file.text()));
      restoring = {next, expected: state.rev};
      $("restoreMeta").textContent = `회의자료 ${fmt(next.rows.length)}건, 품번 재고 ${fmt(next.stocks.length)}건을 불러옵니다. 현재 자료가 이 백업으로 바뀝니다.`;
      $("restoreDialog").showModal();
    } catch {
      notify("이 화면에서 만든 백업 JSON 파일을 확인해 주세요.");
    }
  };
  $("restoreConfirm").onclick = async () => {
    if (restoring && await commit(restoring.next, restoring.expected)) {
      $("restoreDialog").close();
      filter = "all";
      page = 0;
      $("search").value = "";
      changeTab("meeting");
      notify("백업을 복원했습니다.");
    }
  };
  document.querySelectorAll("[data-close]").forEach(button => {
    button.onclick = () => $(button.dataset.close).close();
  });
  window.addEventListener("storage", event => {
    if (event.key !== storageKey || !browserSave) return;
    try { state = readLocal(); render(); }
    catch { notify("다른 탭의 변경사항을 읽지 못했습니다."); }
  });
  render();
}

runMeeting(meetingCore(), meetingFiles());
</script>
</body>
</html>
