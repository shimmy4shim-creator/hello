      return new Date((serial - offset) * 86400000).toISOString().slice(0, 10);
    }
    return "";
  }

  function suggest(cells, fields) {
    const headings = cells.map(header);
    const mapping = {};
    const used = new Set();
    for (const field of fields) {
      let index = -1;
      for (const label of aliases[field]) {
        index = headings.findIndex((name, position) => name === header(label) && !used.has(position));
        if (index >= 0) break;
      }
      if (index >= 0) used.add(index);
      mapping[field] = index;
    }
    return mapping;
  }

  function guess(rows, fields) {
    let best = rows[0]?.number ?? 1;
    let highest = -1;
    for (const row of rows.slice(0, 60)) {
      const mapping = suggest(row.cells, fields);
      const score = fields.filter(field => mapping[field] >= 0)
        .reduce((total, field) => total + (keys.includes(field) ? 12 : 1), 0);
      if (score > highest && score > 0) {
        highest = score;
        best = row.number;
      }
    }
    return {best, score: highest};
  }

  function parseRows(sheet, number, mapping, mode) {
    const required = keys.map(field => mapping[field]);
    if (required.some(index => !Number.isInteger(index) || index < 0) ||
        new Set(required).size !== keys.length) {
      return {error: "발주번호·항번·자재코드에 서로 다른 열을 지정해 주세요."};
    }
    const found = new Map();
    const conflicts = new Set();
    const issues = [];
    let repeats = 0;
    const addIssue = (n, reason) => issues.push({n, reason});
    for (const record of sheet.rows) {
      if (record.number <= number || !record.cells.some(cell => clean(cell))) continue;
      const cell = field => record.cells[mapping[field]];
      const row = {po: clean(cell("po")), line: lineId(cell("line")), material: clean(cell("material"))};
      if (keys.some(field => !row[field])) {
        addIssue(record.number, "발주번호·항번·자재코드 누락");
        continue;
      }
      const delivered = date(cell("delivered"), sheet.date1904);
      if (clean(cell("delivered")) && !delivered) addIssue(record.number, "납품일 형식 확인");
      const id = key(row);
      const previous = found.get(id);
      if (mode === "delivery") {
        if (previous) repeats++;
        if (!previous || delivered > previous.delivered) found.set(id, {...row, delivered});
        continue;
      }

      const due = date(cell("due"), sheet.date1904);
      const qty = quantity(cell("qty"));
      if (clean(cell("due")) && !due) addIssue(record.number, "납기일 형식 확인");
      if (qty === undefined) addIssue(record.number, "납품예정수량은 0 이상의 정수로 입력");
      const done = header(cell("status")) === "납품완료";
      const next = {
        ...row, part: clean(cell("part")), due, qty: qty ?? null,
        sales: clean(cell("sales")), prod: clean(cell("prod")), quality: clean(cell("quality")),
        done, delivered: done ? delivered : ""
      };
      if (conflicts.has(id)) continue;
      if (!previous) {
        found.set(id, next);
        continue;
      }
      const comparedFields = ["part", "due", "qty", ...notes, "delivered"];
      const present = value => value !== "" && value !== null;
      if (comparedFields.some(field => present(previous[field]) && present(next[field]) && previous[field] !== next[field])) {
        found.delete(id);
        conflicts.add(id);
        addIssue(record.number, `중복 키에 서로 다른 값이 있어 제외 · ${describe(row)}`);
        continue;
      }
      repeats++;
      for (const field of comparedFields) if (!present(previous[field])) previous[field] = next[field];
      previous.done ||= next.done;
    }
    return {items: [...found.values()], issues, repeats};
  }

  function reconcile(state, parsed, mode, refreshSchedule) {
    const rows = new Map(state.rows.map(row => [key(row), row]));
    const result = {
      rows, added: [], matched: 0, changed: 0, schedule: 0,
      completed: 0, missing: [], partChanges: [], baseline: !state.rows.length
    };
    for (const incoming of parsed.items) {
      const id = key(incoming);
      const prior = rows.get(id);
      if (mode === "delivery") {
        if (!prior) {
          result.missing.push(describe(incoming));
          continue;
        }
        result.matched++;
        const delivered = [prior.delivered, incoming.delivered].sort().at(-1);
        if (!prior.done || prior.delivered !== delivered) {
          result.changed++;
          if (!prior.done) result.completed++;
          rows.set(id, {...prior, done: true, delivered});
        }
        continue;
      }
      if (!prior) {
        result.added.push(id);
        rows.set(id, incoming);
        continue;
      }
      result.matched++;
      const next = {...prior};
      const scheduleDiffers = (incoming.due && incoming.due !== prior.due) ||
        (incoming.qty !== null && incoming.qty !== prior.qty);
      if (scheduleDiffers) result.schedule++;
      if (refreshSchedule) {
        if (incoming.due) next.due = incoming.due;
        if (incoming.qty !== null) next.qty = incoming.qty;
      }
      if (prior.part && incoming.part && prior.part !== incoming.part) {
        result.partChanges.push(describe(incoming));
      }
      for (const field of ["part", ...notes]) if (!next[field]) next[field] = incoming[field];
      if (incoming.done && !prior.done) {
        next.done = true;
        next.delivered = incoming.delivered;
        result.completed++;
      }
      if (Object.keys(next).some(field => next[field] !== prior[field])) {
        result.changed++;
        rows.set(id, next);
      }
    }
    return result;
  }

  function schedule(state) {
    const compare = new Intl.Collator("ko", {numeric: true}).compare;
    const rows = [...state.rows].sort((a, b) =>
      Number(a.done) - Number(b.done) ||
      (a.due || "9999-99-99").localeCompare(b.due || "9999-99-99") ||
      compare(a.po, b.po) || compare(a.line, b.line) || compare(a.material, b.material) ||
      key(a).localeCompare(key(b)));
    const balances = new Map(state.stocks.map(({part, amount}) => [part, {amount, after: amount, demand: 0}]));
    const planned = rows.map(row => {
      const balance = balances.get(row.part);
      if (row.done || !balance || row.qty === null) return {...row, after: null, shortage: null};
      const shortage = Math.max(0, row.qty - Math.max(0, balance.after));
      balance.after -= row.qty;
      balance.demand += row.qty;
      return {...row, after: balance.after, shortage};
    });
    return {planned, balances};
  }

  return {labels, keys, notes, planFields, deliveryFields, clean, lineId, key, describe, fresh, quantity, date, suggest, guess, parseRows, reconcile, schedule};
}

function meetingFiles() {
