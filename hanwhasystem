<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>한화시스템 주간 회의자료</title>
<style>
:root {
  color-scheme: light;
  --ink: #182e27;
  --muted: #54665e;
  --line: #dde5df;
  --bg: #f3f6f2;
  --green: #145b45;
  --mist: #e6f2eb;
  --amber: #8b4b13;
  font-family: Inter, "Malgun Gothic", system-ui, sans-serif;
}
* { box-sizing: border-box }
[hidden] { display: none !important }
body { margin: 0; color: var(--ink); background: var(--bg); font-size: 14px }
.shell { max-width: 1430px; margin: auto; padding: 28px clamp(12px, 3vw, 42px) 38px }
header, .row, .actions, .filters, .pages, .dialogHead, .dialogFoot {
  display: flex; align-items: center; gap: 10px; flex-wrap: wrap
}
header, .spread, .dialogHead { justify-content: space-between }
h1, h2, p { margin: 0 }
h1 { font-size: clamp(23px, 4vw, 34px); line-height: 1.15; letter-spacing: -.055em }
h2 { font-size: 19px; letter-spacing: -.035em }
p, .muted { color: var(--muted); line-height: 1.55 }
header { margin-bottom: 15px }
.actions { padding: 13px 0 15px }
button, input, select, textarea { font: inherit }
button {
  border: 1px solid #cad8cf; background: #fff; color: var(--ink);
  border-radius: 8px; padding: 9px 13px; cursor: pointer; font-weight: 650
}
button:hover:not(:disabled) { background: #eef5ef }
button:disabled { cursor: default; opacity: .47 }
:focus-visible { outline: 2px solid #218369; outline-offset: 2px }
.primary { background: var(--green); border-color: var(--green); color: #fff }
.primary:hover:not(:disabled) { background: #104a38 }
.storage { color: var(--green); font-size: 12px; font-weight: 750 }
.storage::before {
  content: ""; display: inline-block; width: 7px; height: 7px;
  border-radius: 50%; background: currentColor; margin-right: 6px; vertical-align: 1px
}
.notice {
  font-size: 12px; padding: 10px 13px; border: 1px solid var(--line);
  border-left: 3px solid #8db39d; border-radius: 7px; background: #f9fbf8
}
.tabs { display: flex; gap: 14px; border-bottom: 1px solid var(--line); margin-bottom: 17px }
.tabs button {
  border: 0; border-radius: 0; background: transparent; color: var(--muted);
  padding: 11px 5px 10px; border-bottom: 2px solid transparent
}
.tabs button[aria-pressed="true"] { color: var(--green); border-bottom-color: var(--green) }
.metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 9px; margin-bottom: 15px }
.metric { padding: 12px 14px; text-align: left; min-width: 0 }
.metric span, .metric strong { display: block }
.metric span { font-size: 12px; color: var(--muted) }
.metric strong { font-size: 26px; line-height: 1.15; margin-top: 5px; font-variant-numeric: tabular-nums }
.metric[aria-pressed="true"] { background: var(--mist); border-color: #7cae98 }
.metric.short strong, .warning { color: var(--amber) }
.panel { background: #fff; border: 1px solid var(--line); border-radius: 12px; overflow: hidden }
.panelHead, .paneBody { padding: 14px 16px }
.panelHead { border-bottom: 1px solid var(--line) }
.pages { justify-content: flex-end; border-top: 1px solid var(--line); padding: 10px 14px; color: var(--muted) }
label { display: grid; gap: 5px; font-size: 13px; font-weight: 650; min-width: 0 }
input, select, textarea {
  min-width: 0; max-width: 100%; padding: 8px 9px; color: var(--ink);
  border: 1px solid #cbd8cf; border-radius: 7px; background: #fff
}
textarea { width: 100%; resize: vertical }
#search { width: min(330px, 60vw) }
.tableWrap { overflow: auto }
table { width: 100%; border-collapse: collapse; text-align: left }
#meetingTable table { min-width: 990px }
thead { background: #f4f7f3; color: #41574d }
th { font-size: 12px; white-space: nowrap }
th, td { padding: 10px 11px; border-bottom: 1px solid #edf0ed; vertical-align: top }
tr:last-child td { border-bottom: 0 }
tr:hover td { background: #fbfcfa }
td small { display: block; margin-top: 3px; color: var(--muted); font-size: 11px; white-space: nowrap }
td.warning small { color: var(--amber) }
.code { font-variant-numeric: tabular-nums; white-space: nowrap }
.numeric { text-align: right; font-variant-numeric: tabular-nums }
.tag {
  display: inline-block; white-space: nowrap; border-radius: 12px; padding: 3px 7px;
  font-size: 11px; font-weight: 750; background: #edf1ed; color: #46584f; margin: 0 3px 3px 0
}
.tag.done { background: var(--mist); color: var(--green) }
.tag.new { background: #fff1d4; color: #744909 }
.noteCell { min-width: 105px; max-width: 170px }
.noteCell span {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  overflow: hidden; white-space: pre-wrap; overflow-wrap: anywhere
}
.compact { padding: 4px 8px; font-size: 12px; white-space: nowrap }
.empty, .emptyCell { text-align: center; color: var(--muted) }
.empty { padding: 48px 12px }
.empty p { margin: 9px 0 15px }
.emptyCell { padding: 24px 10px }
.stockForm { align-items: end; margin: 12px 0 16px }
.stockForm input { width: 180px }
#stockNumber { width: 132px }
.help { padding: 13px 0; font-size: 12px }
.help p { margin-top: 6px }
summary { cursor: pointer; font-weight: 650 }
.fileCell { overflow-wrap: anywhere }
dialog {
  color: var(--ink); border: 1px solid var(--line); border-radius: 13px; padding: 0;
  width: min(845px, calc(100% - 22px)); max-height: 90vh; box-shadow: 0 20px 60px #122a2540
}
dialog.smallDialog { width: min(590px, calc(100% - 22px)) }
dialog::backdrop { background: #101e1a75 }
.dialogHead, .dialogFoot, .dialogBody { padding: 14px 17px }
.dialogHead { border-bottom: 1px solid var(--line) }
.dialogFoot { border-top: 1px solid var(--line); justify-content: flex-end }
.dialogBody { display: grid; gap: 10px }
.map, .fieldGrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9px }
.map select { width: 100% }
.required { color: var(--green); font-size: 10px }
.check { display: flex; align-items: center; gap: 7px }
.review { background: #f2f7f3; border-radius: 8px; padding: 10px 11px; line-height: 1.55 }
.review p, .review details { margin-top: 5px; font-size: 12px }
.review ul { margin: 6px 0 }
.counts { display: flex; gap: 6px 18px; flex-wrap: wrap }
.filename { overflow-wrap: anywhere; font-size: 12px }
.toast {
  position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%); z-index: 10;
  width: max-content; max-width: calc(100% - 22px); color: #fff; background: #184b3b;
  padding: 10px 15px; border-radius: 8px; box-shadow: 0 6px 25px #162b2650
}
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%) }
@media (max-width: 620px) {
  .metrics, .map, .fieldGrid { grid-template-columns: repeat(2, minmax(0, 1fr)) }
  .metric { padding: 10px }
  .metric strong { font-size: 22px }
  .panelHead { align-items: flex-start }
  .shell { padding-top: 17px }
}
</style>
</head>
<body>
<main class="shell">
  <header>
    <h1>한화시스템 주간 회의자료</h1>
    <span class="storage" id="browserStatus"></span>
  </header>
  <p class="notice">작업 환경 연결 문제로 웹 배포와 기존 엑셀 두 파일의 검증이 보류됐습니다. 이 미리보기에서 파일을 올려 시트와 열을 확인한 뒤 반영하세요.</p>
  <div class="actions">
    <button id="planButton" class="primary">3개월 계획 업로드</button>
    <button id="deliveryButton">납품완료 목록 업로드</button>
    <button id="export">회의자료 엑셀 저장</button>
    <input id="planFile" type="file" accept=".xlsx,.csv,.tsv" hidden>
    <input id="deliveryFile" type="file" accept=".xlsx,.csv,.tsv" hidden>
  </div>
  <nav class="tabs" aria-label="회의자료 메뉴">
    <button id="meetingTab">회의자료</button>
    <button id="inventoryTab">품번 재고</button>
    <button id="historyTab">반영 이력</button>
  </nav>
  <section id="meetingPane" aria-label="회의자료">
    <div class="metrics" id="counters"></div>
    <div class="panel">
      <div class="panelHead row spread">
        <div class="filters">
          <label class="sr" for="search">발주번호, 항번, 자재코드, 품번 검색</label>
          <input id="search" type="search" placeholder="발주번호·자재코드·품번 검색">
          <label class="sr" for="filter">상태 필터</label>
          <select id="filter">
            <option value="all">전체</option>
            <option value="open">납품예정</option>
            <option value="new">신규 추가</option>
            <option value="done">납품완료</option>
            <option value="short">재고 부족</option>
          </select>
        </div>
        <span class="muted" id="meetingCount"></span>
      </div>
      <div class="empty" id="meetingEmpty">
        <h2>기존 3개월 계획표를 올려 시작하세요</h2>
        <p>첫 파일이 기준 자료가 됩니다. 이후 계획에서 새로 들어온 항목에 ‘신규 추가’가 표시됩니다.</p>
        <button class="primary" id="firstPlan">계획 엑셀 선택</button>
      </div>
      <div id="meetingTable" hidden>
        <div class="tableWrap">
          <table aria-label="납품 회의자료">
            <thead>
              <tr>
                <th>발주번호 / 항번</th><th>자재코드 / 품번</th><th>납기일</th>
                <th class="numeric">예정수량</th><th class="numeric">배정 후 예상 재고</th>
                <th>상태</th><th>영업</th><th>생산관리</th><th>품질</th><th>확인사항</th>
              </tr>
            </thead>
            <tbody id="orders"></tbody>
          </table>
        </div>
        <div class="pages">
          <button class="compact" id="prev">이전</button><span id="pages"></span><button class="compact" id="next">다음</button>
        </div>
      </div>
    </div>
    <details class="help">
      <summary>반영 기준</summary>
      <p>발주번호·항번·자재코드로 계획과 납품완료 목록을 대조합니다. 기존 행과 확인사항은 유지하고, 납품완료 목록에서 일치한 행의 상태를 바꿉니다.</p>
      <p>계획 업로드에서 일치 항목의 납기일·예정수량 갱신을 선택할 수 있습니다. ‘신규 추가’는 변경사항이 반영된 최근 계획을 기준으로 표시합니다.</p>
    </details>
  </section>
  <section id="inventoryPane" class="panel" hidden aria-labelledby="inventoryTitle">
    <div class="paneBody">
      <h2 id="inventoryTitle">품번별 기준 재고</h2>
      <form id="stockForm" class="stockForm row">
        <label>품번<input id="stockPart" list="partOptions" placeholder="A40007404" required></label>
        <datalist id="partOptions"></datalist>
        <label>현재 실재고<input id="stockNumber" type="number" min="0" step="1" placeholder="9" required></label>
        <button class="primary" type="submit">재고 반영</button>
      </form>
      <p>같은 품번의 미납 수량을 납기일 순으로 차감합니다. 재고 9개에 예정수량 2개, 2개, 3개를 배정하면 예상 재고는 7개, 5개, 2개입니다.</p>
      <p>납기 미정 건은 마지막에 배정됩니다. 납품완료 반영 후 실재고가 달라지면 등록 수량을 갱신하세요.</p>
    </div>
    <div class="tableWrap">
      <table aria-label="품번별 예상 재고">
        <thead><tr><th>품번</th><th class="numeric">등록 재고</th><th class="numeric">미납 예정수량</th><th class="numeric">배정 후 예상 재고</th><th>재고 입력</th></tr></thead>
        <tbody id="stockRows"></tbody>
      </table>
    </div>
  </section>
  <section id="historyPane" class="panel" hidden aria-labelledby="historyTitle">
    <div class="panelHead row spread">
      <h2 id="historyTitle">파일 반영 이력</h2>
      <div class="row">
        <button id="backup">백업 저장</button><button id="restoreButton">백업 복원</button>
        <input id="restoreFile" type="file" accept=".json" hidden>
      </div>
    </div>
    <div class="tableWrap">
      <table aria-label="파일 반영 이력">
        <thead><tr><th>반영일시</th><th>유형</th><th>파일명</th><th>반영 결과</th></tr></thead>
        <tbody id="historyRows"></tbody>
      </table>
    </div>
  </section>
</main>
<dialog id="importDialog" aria-labelledby="importTitle">
  <div class="dialogHead">
    <h2 id="importTitle"></h2><span class="muted filename" id="filename"></span>
  </div>
  <div class="dialogBody">
    <label>시트<select id="sheetSelect"></select></label>
    <p id="importMessage" role="status"></p>
    <div id="importBody" class="dialogBody" style="padding:0" hidden>
      <label>열 이름이 있는 행 번호<input id="headerRow" type="number" min="1" step="1"></label>
      <div class="map" id="mapping"></div>
      <p id="materialHint">품번과 자재코드가 같은 열에 있다면 두 항목에 그 열을 지정하세요.</p>
      <label id="refreshLine" class="check"><input id="refresh" type="checkbox">일치 항목의 납기일·납품예정수량도 갱신</label>
      <div class="review" id="review" aria-live="polite"></div>
    </div>
  </div>
  <div class="dialogFoot">
    <button type="button" data-close="importDialog">취소</button>
    <button class="primary" id="apply" disabled>회의자료에 반영</button>
  </div>
</dialog>
<dialog id="editDialog" class="smallDialog" aria-labelledby="editTitle">
  <div class="dialogHead">
    <h2 id="editTitle">항목 편집</h2><span class="muted filename" id="editMeta"></span>
  </div>
  <form id="editForm">
    <div class="dialogBody">
      <div class="fieldGrid">
        <label>품번<input id="editPart"></label>
        <label>납기일<input id="editDue" type="date" min="1900-01-01"></label>
        <label>납품예정수량<input id="editQuantity" type="number" min="0" step="1"></label>
      </div>
      <div class="dialogBody" id="noteFields" style="padding:0"></div>
    </div>
    <div class="dialogFoot">
      <button type="button" data-close="editDialog">취소</button><button type="submit" class="primary">저장</button>
    </div>
  </form>
</dialog>
<dialog id="restoreDialog" class="smallDialog" aria-labelledby="restoreTitle">
  <div class="dialogHead"><h2 id="restoreTitle">백업 복원</h2></div>
  <div class="dialogBody"><p id="restoreMeta"></p></div>
  <div class="dialogFoot">
    <button type="button" data-close="restoreDialog">취소</button><button class="primary" id="restoreConfirm">복원</button>
  </div>
</dialog>
<div class="toast" id="toast" role="status" hidden></div>

<script>
function meetingCore() {
  const labels = {
    po: "발주번호", line: "항번", material: "자재코드", part: "품번",
    due: "납기일", qty: "납품예정수량", sales: "영업 확인사항", prod: "생산관리 확인사항",
    quality: "품질 확인사항", status: "진행상태", delivered: "납품일"
  };
  const keys = ["po", "line", "material"];
  const notes = ["sales", "prod", "quality"];
  const planFields = [...keys, "part", "due", "qty", ...notes, "status", "delivered"];
  const deliveryFields = [...keys, "delivered"];
  const aliases = {
    po: ["발주번호", "발주번호PO", "발주NO", "구매오더", "구매오더번호", "구매문서번호", "구매문서", "오더번호", "PONO", "PONUMBER", "PURCHASEORDER"],
    line: ["항번", "발주항번", "행번", "발주순번", "구매오더품목", "구매문서품목", "발주품목번호", "항목번호", "품목항번", "POLINE", "LINE", "LINENO", "ITEMNO"],
    material: ["자재코드", "자재번호", "자재", "품목코드", "고객자재코드", "고객사자재코드", "MATERIAL", "MATERIALCODE", "MATERIALNO"],
    part: ["품번", "품목번호", "부품번호", "도번", "도면번호", "업체품번", "고객품번", "PARTNO", "PARTNUMBER"],
    due: ["납기일", "납기", "납품예정일", "납품계획일", "요청납기", "요청납기일", "납기요청일", "기준납기", "조달납기", "업체납기", "납기일자", "납기일납품예정일", "DUEDATE"],
    qty: ["납품예정수량", "납품계획수량", "납품수량", "미납수량", "잔여수량", "미결수량", "발주수량", "주문수량", "수량", "납품예정수량EA", "수량EA", "수량개", "QTY", "QUANTITY"],
    sales: ["영업확인사항", "영업", "영업확인", "영업비고", "영업팀", "영업팀확인사항"],
    prod: ["생산관리확인사항", "생산관리", "생산확인사항", "생산관리비고", "생산", "생산팀확인사항"],
    quality: ["품질확인사항", "품질", "품질확인", "품질비고", "품질관리", "품질팀확인사항"],
    status: ["진행상태", "납품상태", "상태", "납품여부"],
    delivered: ["납품일", "납품완료일", "실제납품일", "납품일자", "실납품일", "납품일거래명세서날짜", "거래명세서날짜", "거래명세서일자", "송장일자", "송장날짜", "배송일자", "출하일", "출고일자", "배송완료일", "DELIVERYDATE"]
  };

  const clean = value => String(value ?? "").trim().normalize("NFC");
  const header = value => clean(value).normalize("NFKC").toLowerCase().replace(/[^a-z0-9가-힣]/g, "");
  const lineId = value => clean(value).replace(/^0*(\d+)(?:\.0+)?$/, "$1");
  const key = row => JSON.stringify([row.po, row.line, row.material]);
  const describe = row => `${row.po} / ${row.line} / ${row.material}`;
  const fresh = () => ({schema: 1, rev: "", rows: [], stocks: [], newest: [], history: []});

  function quantity(value) {
    const text = clean(value);
    if (!text) return null;
    if (!/^(?:\d+|\d{1,3}(?:,\d{3})+)(?:\.0+)?$/.test(text)) return undefined;
    const n = Number(text.replaceAll(",", ""));
    return Number.isSafeInteger(n) ? n : undefined;
  }

  function date(value, date1904 = false) {
    const text = clean(value);
    if (!text) return "";
    const match = text.match(/^(\d{4})(\d{2})(\d{2})$/) ||
      text.match(/^(\d{4})[.\-/년\s]+(\d{1,2})[.\-/월\s]+(\d{1,2})(?:[.일])?(?:[T\s].*)?$/);
    if (match) {
      const [, year, month, day] = match.map(Number);
      const parsed = new Date(Date.UTC(year, month - 1, day));
      if (year >= 1900 && parsed.getUTCFullYear() === year &&
          parsed.getUTCMonth() === month - 1 && parsed.getUTCDate() === day) {
        return parsed.toISOString().slice(0, 10);
      }
      return "";
    }
    if (/^\d{1,7}(?:\.\d+)?$/.test(text)) {
      const serial = Math.floor(Number(text));
      if (serial > (date1904 ? 2957003 : 2958465) || (!date1904 && (serial === 0 || serial === 60))) return "";
